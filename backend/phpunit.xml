<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The architecture tests parse every source file to build their object
            graph, so the suite's memory need grows with the codebase rather
            than with any one test. 512M leaves plenty of headroom; the default
            128M is exhausted around the size this project already is.
        -->
        <ini name="memory_limit" value="512M"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Tests run against real PostgreSQL, not SQLite: the schema relies on
            UUID keys, JSONB and constraints whose behaviour SQLite does not
            reproduce. DB_DATABASE is overridden to the dedicated test database.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="digitalsmart_test"/>
        <env name="DB_URL" value=""/>
        <!-- Deterministic and isolated: no Redis, no realtime, no mail, no network. -->
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Deterministic rate limits: a developer's .env must not change what the suite asserts. -->
        <env name="RATE_LIMIT_AUTH" value="5" force="true"/>
        <env name="RATE_LIMIT_API_USER" value="120" force="true"/>
        <env name="RATE_LIMIT_API_GUEST" value="30" force="true"/>
        <env name="RATE_LIMIT_HEALTH" value="60" force="true"/>
    </php>
</phpunit>

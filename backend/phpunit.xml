<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnWarning="true"
         failOnDeprecation="true"
         failOnNotice="true"
         failOnRisky="true"
         failOnEmptyTestSuite="true"
         beStrictAboutOutputDuringTests="true"
         cacheDirectory=".phpunit.cache"
>
    <testsuites>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!--
            The architecture tests parse every source file to build their object
            graph, so the suite's memory need grows with the codebase rather
            than with any one test. The default 128M is exhausted around the
            size this project reached in Phase 3; 512M carried it to about
            1,125 tests and was exhausted mid-run at roughly 1,150, in the
            Analytics suite rather than in whatever had grown.

            1G rather than a smaller bump because the failure mode is
            expensive: the suite dies partway with a fatal error naming a
            vendor file, which reads as a broken test rather than as a limit.
            Running the suite in parallel would bound this per process instead,
            and is the better answer once creating per-worker databases is part
            of the local setup. (A double hyphen cannot appear in an XML
            comment, which is why that flag is described rather than written.)

            2G since 2026-10-19: at about 2,100 tests the 1G limit was
            exhausted on CI in the same way, in an Operations upload test that
            had not changed. The GitHub runner has 7G; the parallel run above
            is still the real answer.
        -->
        <ini name="memory_limit" value="2G"/>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <!--
            Tests run against real PostgreSQL, not SQLite: the schema relies on
            UUID keys, JSONB and constraints whose behaviour SQLite does not
            reproduce. DB_DATABASE is overridden to the dedicated test database.
        -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="digitalsmart_test"/>
        <env name="DB_URL" value=""/>
        <!-- Deterministic and isolated: no Redis, no realtime, no mail, no network. -->
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <!-- Deterministic rate limits: a developer's .env must not change what the suite asserts. -->
        <env name="RATE_LIMIT_AUTH" value="5" force="true"/>
        <env name="RATE_LIMIT_API_USER" value="120" force="true"/>
        <env name="RATE_LIMIT_API_GUEST" value="30" force="true"/>
        <env name="RATE_LIMIT_HEALTH" value="60" force="true"/>
    </php>
</phpunit>

################################################################################
# digitalSmart backend — copy to .env and fill in. Never commit .env.
################################################################################

APP_NAME=digitalSmart
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_VERSION=0.1.0
APP_TIMEZONE=UTC
APP_URL=http://127.0.0.1:8001

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Comma-separated SPA origins allowed to hold a stateful session.
FRONTEND_URL=http://127.0.0.1:5174
SANCTUM_STATEFUL_DOMAINS=127.0.0.1:5174,localhost:5174

# Leave empty for a host-only cookie. Setting it to "localhost" stops cookies
# being issued for 127.0.0.1, which silently breaks the SPA session. Set it
# only in deployed environments that share cookies across subdomains
# (e.g. ".digitalsmart.app").
SESSION_DOMAIN=

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ---------------------------------------------------------------- PostgreSQL --
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=digitalsmart
DB_USERNAME=digitalsmart
DB_PASSWORD=digitalsmart

# Separate database for the test suite; it is migrated fresh and truncated.
DB_TEST_DATABASE=digitalsmart_test

# --------------------------------------------------------------------- Redis --
REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
REDIS_DB=0
REDIS_CACHE_DB=1

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# Where client-request attachments live. The private local disk here; a bucket in production.
# Nothing on it is public: every read goes through the API, where the audience rule lives.
ATTACHMENT_DISK=local

# ------------------------------------------------------------------- Horizon --
HORIZON_PREFIX=digitalsmart_horizon
HORIZON_DOMAIN=

# ----------------------------------------------- Reverb (WebSockets/realtime) --
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=digitalsmart
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# --------------------------------------------------------------------- Mail ---
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@digitalsmart.local"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------- Observability --
SLOW_QUERY_THRESHOLD_MS=500

################################################################################
# Ad platform integrations — BLOCKED_EXTERNAL until credentials are provisioned.
# Each adapter has a full contract, sandbox fixtures and tests without these.
# See docs/INTEGRATIONS.md for how to obtain every value.
################################################################################
META_ADS_CLIENT_ID=
META_ADS_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
TIKTOK_ADS_APP_ID=
TIKTOK_ADS_APP_SECRET=
SNAPCHAT_ADS_CLIENT_ID=
SNAPCHAT_ADS_CLIENT_SECRET=
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
LINKEDIN_ADS_CLIENT_ID=
LINKEDIN_ADS_CLIENT_SECRET=
OPENAI_ADS_API_KEY=

# CRM. Read-only by design: the CRM owns its own pipeline, so nothing here writes a stage back.
# See docs/CRM.md for which scopes the installing account has to grant.
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Comma-separated e-mails allowed to open the Horizon dashboard outside local dev.
HORIZON_ALLOWED_EMAILS=

# OpenAPI document version (defaults to APP_VERSION).
API_VERSION=0.1.0

# Rate limits (requests per minute). Keep RATE_LIMIT_AUTH low in production:
# it guards both the IP and the individual account against brute force.
RATE_LIMIT_API_USER=120
RATE_LIMIT_API_GUEST=30
RATE_LIMIT_HEALTH=60
RATE_LIMIT_AUTH=5

# The assistant's language model. BLOCKED_EXTERNAL: no key is held by this repository.
# Leave it empty and the assistant still works — every finding and every figure is computed
# by the product, and the narrative is composed from them without a model. A key buys better
# prose and nothing else.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=claude-sonnet-5-5
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_TIMEOUT=20

# The workspace (by slug) that takes requests for an account from the public landing page. Empty: none are taken.
ACCESS_REQUESTS_WORKSPACE_SLUG=

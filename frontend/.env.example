# digitalSmart frontend — copy to .env.local and adjust.
# Vite only exposes variables prefixed with VITE_.

VITE_APP_NAME=digitalSmart

# Same-origin by default: the dev server proxies /api to VITE_DEV_API_PROXY.
VITE_API_BASE_URL=/api

# Backend origin used by the dev-server proxy (not shipped to the browser).
VITE_DEV_API_PROXY=http://127.0.0.1:8001

# Realtime (Laravel Reverb). Leave VITE_REVERB_APP_KEY empty to disable realtime locally.
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http

# Show DEMO/SANDBOX-labelled seed data in the UI.
VITE_SHOW_DEMO_DATA=false

# Environment
.env
.env.*
!.env.example

# Dependencies
vendor/
node_modules/

# Build output
dist/
build/
coverage/
playwright-report/
test-results/
/docs/openapi.json

# Framework caches
.phpunit.cache/
.phpunit.result.cache
backend/storage/*.key
backend/storage/framework/cache/data/*
backend/storage/framework/sessions/*
backend/storage/framework/testing/*
backend/storage/framework/views/*
backend/storage/logs/*
backend/public/storage

# Database dumps. Real client data, by definition — never in the repository, and never in a
# bucket the application itself can read (see docs/RUNBOOKS.md).
/storage/backups/

# Cookie jars the load harness reuses between runs: real sessions, so never committed.
/storage/load/
backend/public/vendor/horizon
backend/bootstrap/cache/*.php
!backend/**/.gitignore

# Editors and OS
.DS_Store
.idea/
.vscode/
*.swp

# The unzipped brand kit is a working copy, not part of the application: it carries fonts and source files for
# print and social that the app does not ship. The assets the app uses are copied into frontend/ by path.
/brand/
